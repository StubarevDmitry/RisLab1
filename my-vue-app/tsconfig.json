{
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["ES2015", "DOM"],
    "strict": true,
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "vueCompilerOptions": {
    "strictTemplates": true,
    "checkUnknownProps": true, 
    "checkUnknownEvents": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.vue"
  ]
}